---
// Bordered card for one capability: optional icon slot, eyebrow, sentence-case title, body, mono spec line.
interface Props {
  title: string;
  eyebrow?: string;
  spec?: string;
  tone?: 'surface' | 'block';
  class?: string;
}
const { title, eyebrow, spec, tone = 'surface', class: className } = Astro.props;
const classes = ['ts-card', tone === 'block' && 'ts-card--block', className]
  .filter(Boolean)
  .join(' ');
---

<div class={classes}>
  {Astro.slots.has('icon') && <div class="ts-card__icon"><slot name="icon" /></div>}
  {eyebrow && <span class={`ts-eyebrow${tone === 'block' ? ' ts-eyebrow--on-block' : ''}`}>{eyebrow}</span>}
  <h3 class="ts-card__title">{title}</h3>
  <p class="ts-card__body"><slot /></p>
  {spec && <p class="ts-card__spec">{spec}</p>}
</div>

<style is:global>
  .ts-card {
    display: flex; flex-direction: column; gap: var(--space-3);
    box-sizing: border-box; padding: var(--space-5);
    background: var(--surface); color: var(--ink);
    border: 2px solid var(--line-strong); border-radius: var(--radius-none);
  }
  .ts-card__icon { width: 28px; height: 28px; color: var(--ink); }
  .ts-card__icon svg { width: 100%; height: 100%; display: block; }
  .ts-card__title { font-family: var(--font-sans); font-size: 22px; line-height: 1.15; font-weight: 700; letter-spacing: -0.02em; margin: 0; }
  .ts-card__body { font-family: var(--font-sans); font-size: 14px; line-height: 1.5; margin: 0; color: var(--ink-muted); }
  .ts-card__spec { font-family: var(--font-mono); font-size: 14px; line-height: 1.6; margin: 0; color: var(--ink); padding-top: var(--space-2); border-top: 1px solid var(--line-soft); }
  .ts-card--block { background: var(--block); color: var(--on-block); border-color: var(--block); }
  .ts-card--block .ts-card__icon { color: var(--on-block); }
  .ts-card--block .ts-card__body { color: var(--on-block-muted); }
  .ts-card--block .ts-card__spec { color: var(--on-block); border-top-color: var(--on-block-muted); }
</style>
