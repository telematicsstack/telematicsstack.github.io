---
// One number and its caption. Compose in a grid with an 8px gap; mix tones.
interface Props {
  value: string;
  label: string;
  tone?: 'outline' | 'volt' | 'block';
  class?: string;
}
const { value, label, tone = 'outline', class: className } = Astro.props;
const classes = ['ts-stat', `ts-stat--${tone}`, className].filter(Boolean).join(' ');
---

<div class={classes}>
  <p class="ts-stat__value">{value}</p>
  <p class="ts-stat__label">{label}</p>
</div>

<style is:global>
  .ts-stat {
    display: flex; flex-direction: column; gap: var(--space-1);
    box-sizing: border-box; padding: var(--space-4) var(--space-5);
    border: 2px solid var(--line-strong); border-radius: var(--radius-none);
    min-width: 160px;
  }
  .ts-stat__value { font-family: var(--font-display); font-size: 40px; line-height: 0.9; letter-spacing: -0.04em; text-transform: uppercase; margin: 0; }
  .ts-stat__label { font-family: var(--font-mono); font-size: 11px; line-height: 1.4; letter-spacing: 0.04em; text-transform: uppercase; margin: 0; }
  .ts-stat--volt { background: var(--volt); border-color: var(--volt); color: var(--on-volt); }
  .ts-stat--volt .ts-stat__label { color: var(--on-volt); }
  .ts-stat--block { background: var(--block); border-color: var(--block); color: var(--on-block); }
  .ts-stat--block .ts-stat__label { color: var(--on-block-muted); }
  .ts-stat--outline { background: var(--surface); color: var(--ink); }
  .ts-stat--outline .ts-stat__label { color: var(--ink-muted); }
</style>
